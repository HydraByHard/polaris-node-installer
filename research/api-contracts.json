  "authentication": {
    "nativeApiRole": "Authorization: Bearer <temporary API JWT>; browser header not needed",
    "adminSession": "Token create/list/scopes/delete require ADMIN JWT and X-Remnawave-Client-Type: browser. API role receives403 even with DELETE permission guesses.",
    "apiTokenClaims": [
      "uuid",
      "username",
      "role",
      "iat",
      "exp"
    ],
    "scopesInJwt": false,
    "scopeStorage": "Panel database; JWT claims do not enumerate effective scopes",
    "tokenCreation": {
      "method": "POST",
      "path": "/api/tokens",
      "body": {
        "name": "descriptive string",
        "expiresInDays": 1,
        "scopes": [
          "system:metadata",
          "nodes:list",
          "nodes:get",
          "nodes:create",
          "config-profiles:list",
          "config-profiles:get",
          "config-profiles:create",
          "keygen:get",
          "hosts:list",
          "hosts:create"
        ]
      },
      "minimumExpiryDays": 1,
      "invalidScopeStatus": 400,
      "zeroDayExpiryStatus": 400
    },
    "tokenRevocation": {
      "method": "DELETE",
      "path": "/api/tokens/{uuid}",
      "success": 204,
      "adminOnly": true,
      "apiSelfRevocation": false
    },
    "nativeOtt": "POST /api/tokens/ott is for short-lived Swagger/Scalar/Bull Board backend tools access, not one-time Node enrollment.",
    "apiTokenCanInspectScopeCatalog": false
  },
  "enrollmentScopes": [
    "system:metadata",
    "nodes:list",
    "nodes:get",
    "nodes:create",
    "config-profiles:list",
    "config-profiles:get",
    "config-profiles:create",
    "keygen:get",
    "hosts:list",
    "hosts:create"
