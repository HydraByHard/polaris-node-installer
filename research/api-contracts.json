  "publishScopes": [
    "system:metadata",
    "nodes:get",
    "config-profiles:get",
    "hosts:get",
    "hosts:update",
    "internal-squads:list",
    "internal-squads:get",
    "internal-squads:update"
  ],
  "rollbackScopes": [
    "hosts:delete",
    "nodes:delete",
    "config-profiles:delete"
  ],
  "responseWrappers": {
    "GET /api/system/metadata": "{response:{version,build:{time,number},git:{backend,frontend}}}; authentication required401 withouttoken",
    "GET /api/nodes": "{response:[node,...]}",
    "GET /api/nodes/{uuid}": "{response:node}; fields isConnected,isConnecting,isDisabled,xrayUptime,lastStatusMessage,versions:{node,xray}",
    "GET /api/config-profiles": "{response:{total,configProfiles:[profile,...]}}",
    "GET /api/config-profiles/{uuid}": "{response:profile}; includes config and inbounds:[{uuid,tag,...}]",
    "GET /api/hosts": "{response:[host,...]}",
    "GET /api/internal-squads": "{response:{total,internalSquads:[squad,...]}}",
    "GET /api/internal-squads/{uuid}": "{response:squad}; inbounds is an array of inbound objects containing uuid",
    "POST /api/users": "{response:user}; numeric id field, no uuid field in tested3.4.11. Enrollment/publish requires no users access."
  },
  "nodeKeygen": {
    "method": "GET",
    "path": "/api/keygen",
    "scope": "keygen:get",
    "responseFields": [
      "secretKey",
      "pubKey"
    ],
    "secretKeyFormat": "Base64-encoded JSON",
    "payloadFields": [
      "nodeCertPem",
      "nodeKeyPem",
      "caCertPem",
      "jwtPublicKey"
    ],
    "verified": "Successive requests mint different per-node certificate/private key; CA certificate remains shared; CA private key absent. Never log or commit payload."
  },
  "createProfile": {
    "method": "POST",
    "path": "/api/config-profiles",
    "scope": "config-profiles:create",
    "nameConstraints": "2..30 ASCII letters/numbers/underscore/space/hyphen",
    "body": {
      "name": "PNI isolated profile",
      "config": {
        "log": {
          "loglevel": "warning"
        },
        "inbounds": [
          {
            "tag": "pni-owned-inbound",
            "listen": "127.0.0.1",
            "port": 8082,
            "protocol": "vless",
            "settings": {
              "clients": [],
              "decryption": "none"
            },
            "streamSettings": {
              "network": "xhttp",
              "security": "none",
              "xhttpSettings": {
                "path": "/unique-node-path/",
                "mode": "packet-up"
              }
            }
          }
        ],
        "outbounds": [
          {
            "tag": "direct",
            "protocol": "freedom"
          }
        ]
      }
    }
  },
  "createNode": {
    "method": "POST",
    "path": "/api/nodes",
    "scope": "nodes:create",
    "body": {
      "name": "new-node-name",
      "address": "new-node-domain",
      "port": 2222,
      "countryCode": "FI",
      "tags": [
        "PNI_OWNED_MARKER"
      ],
      "configProfile": {
        "activeConfigProfileUuid": "<new profile uuid>",
        "activeInbounds": [
          "<new inbound uuid>"
        ]
      }
    },
    "nameConstraints": "3..30 characters"
  },
  "createHost": {
    "method": "POST",
    "path": "/api/hosts",
    "scope": "hosts:create",
    "body": {
      "remark": "PNI unique ownership marker",
      "address": "new-node-domain",
      "port": 443,
      "path": "/unique-node-path/",
      "sni": "new-node-domain",
      "host": "new-node-domain",
      "alpn": "h2",
      "securityLayer": "TLS",
      "isDisabled": true,
      "isHidden": true,
      "nodes": [
        "<new node uuid>"
      ],
      "inbound": {
        "configProfileUuid": "<new profile uuid>",
        "configProfileInboundUuid": "<new inbound uuid>"
      },
      "xhttpExtraParams": {
        "mode": "packet-up"
      }
    },
    "verifiedIsolation": "Existing Host/profile/Polaris personal inbounds/user identities and subscription URL unchanged; no enrollment Squad mutation."
  },
  "publish": {
    "precondition": "Separate owner-confirmed operation with separate temporary publication scopes. Read latest Squad immediately before mutation.",
    "squad": {
      "method": "PATCH",
      "path": "/api/internal-squads",
      "scope": "internal-squads:update",
      "body": {
        "uuid": "<Polaris personal uuid>",
        "inbounds": [
          "<every existing inbound uuid retained>",
          "<owned new inbound uuid>"
        ]
      },
      "semantics": "Replaces entire inbounds array; there is no append command. Union existing UUIDs, detect concurrent changes, never replace with new-only list."
    },
    "host": {
      "method": "PATCH",
      "path": "/api/hosts",
      "scope": "hosts:update",
      "body": {
        "uuid": "<owned Host uuid>",
        "isDisabled": false,
        "isHidden": false
      }
    },
    "unpublish": "PATCH exactly the owned Host isDisabled:true,isHidden:true; do not remove old Squad permissions or users."
  },
  "remoteRollback": {
    "precondition": "Explicit owner confirmation; verify local owned UUIDs against remote marker and relationships; delete only own resources",
    "sequence": [
      "DELETE /api/hosts/{ownedUuid}",
      "DELETE /api/nodes/{ownedUuid}",
      "DELETE /api/config-profiles/{ownedUuid}"
    ],
    "successStatus": 204,
    "forbiddenForEnrollment": true
  },
